{
    "comments": {
        "lineComment": "//",
        "blockComment": ["/*", "*/"]    
      },
      "brackets": [["{", "}"], ["[", "]"], ["(", ")"]],
      "autoClosingPairs": [
        { "open": "{", "close": "};"},
        { "open": "[", "close": "]" },
        { "open": "(", "close": ")" },
        { "open": "'", "close": "'", "notIn": ["string", "comment"] },
        { "open": "\"", "close": "\"", "notIn": ["string"] },
        { "open": "`", "close": "`", "notIn": ["string", "comment"] },
        { "open": "/**", "close": " */", "notIn": ["string"] }
      ],
      "autoCloseBefore": ":.,=}])>` \n\t",
      "surroundingPairs": [
        ["{", "}"],
        ["[", "]"],
        ["(", ")"],
        ["'", "'"],
        ["\"", "\""],
        ["`", "`"]
      ],
      "folding": {
        "markers": {
          "start": "^\\s*(?://\\s*#?region\\b|ADDTOSCRIPT:|INSERTINTOSCRIPT:|SCRIPT:)",
          "end": "^\\s*(?://\\s*#?endregion\\b|ENDSCRIPT)\\b"
        }
      },
      "indentationRules": {
        "increaseIndentPattern": "^((?!\\/\\/).)*(\\{[^}\"'`]*|\\([^)\"'`]*|\\[[^\\]\"'`]*)$",
        "decreaseIndentPattern": "^((?!.*?\\/\\*).*\\*/)?\\s*[\\}\\]].*$",
      }
}